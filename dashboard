<!DOCTYPE html>
<html>
<head>

<title>Admin Dashboard</title>

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

<style>

body{
    background-color:rgb(210, 195, 198);
}

.sidebar{
    width:220px;
    height:100vh;
    background-color:#343a40;
    position:fixed;
    padding-top:20px;
}

.sidebar h2{
    color:white;
    text-align:center;
    margin-bottom:20px;
}

.sidebar a{
    display:block;
    color:white;
    text-decoration:none;
    padding:10px;
    margin:5px;
}

.sidebar a:hover{
    background-color:blue;
}

.content{
    margin-left:230px;
    padding:20px;
}

.card{
    margin-bottom:20px;
}

.section{
    display:none;
}

.section:target{
    display:block;
}

#home{
    display:block;
}

table{
    background-color:white;
}

</style>

</head>

<body>

<div class="sidebar">

    <h2>Dashboard</h2>

    <a href="#home">Home</a>
    <a href="#students">Students</a>
    <a href="#courses">Courses</a>
    <a href="#exams">Exams</a>

</div>

<div class="content">

    <div id="home" class="section">

        <h1>Home Page</h1>

        <div class="row">

            <div class="col-md-4">

                <div class="card p-3 text-center">

                    <h4>Total Students</h4>
                    <h2 class="text-primary">1200</h2>

                </div>

            </div>

            <div class="col-md-4">

                <div class="card p-3 text-center">

                    <h4>Total Courses</h4>
                    <h2 class="text-success">35</h2>

                </div>

            </div>

            <div class="col-md-4">

                <div class="card p-3 text-center">

                    <h4>Total Exams</h4>
                    <h2 class="text-danger">12</h2>

                </div>

            </div>

        </div>

    </div>

    <div id="students" class="section">

        <h1>Students</h1>

        <table class="table table-bordered">

            <tr>
                <th>ID</th>
                <th>Name</th>
                <th>Course</th>
            </tr>

            <tr>
                <td>101</td>
                <td>Rahul</td>
                <td>BCA</td>
            </tr>

            <tr>
                <td>102</td>
                <td>Priya</td>
                <td>MCA</td>
            </tr>

        </table>

    </div>

    <div id="courses" class="section">

        <h1>Courses</h1>

        <ul class="list-group">

            <li class="list-group-item">BCA</li>
            <li class="list-group-item">MCA</li>
            <li class="list-group-item">MBA</li>
            <li class="list-group-item">BSc IT</li>

        </ul>

    </div>

    <div id="exams" class="section">

        <h1>Exams</h1>

        <table class="table table-bordered">

            <tr>
                <th>Exam</th>
                <th>Date</th>
            </tr>

            <tr>
                <td>Semester 1</td>
                <td>10 May 2026</td>
            </tr>

            <tr>
                <td>Semester 2</td>
                <td>25 May 2026</td>
            </tr>

        </table>

    </div>

</div>

</body>
</html>
