<!DOCTYPE html>
<html>
<head>

<title>College Dashboard</title>

<meta name="viewport" content="width=device-width, initial-scale=1">

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

<style>

body{
    background-color:#f2f2f2;
}

.sidebar{
    width:220px;
    height:100vh;
    background-color:black;
    position:fixed;
    padding-top:20px;
}

.sidebar h2{
    color:white;
    text-align:center;
}

.sidebar a{
    display:block;
    color:white;
    text-decoration:none;
    padding:10px;
    margin:5px;
}

.sidebar a:hover{
    background-color:blue;
}

.content{
    margin-left:230px;
    padding:20px;
}

.page{
    display:none;
}

.page:target{
    display:block;
}

#home{
    display:block;
}

.card{
    padding:20px;
    text-align:center;
    margin-bottom:20px;
}

</style>

</head>

<body>

<div class="sidebar">

    <h2>I2IT Pune</h2>

    <a href="#home">Home</a>
    <a href="#courses">Courses</a>
    <a href="#faculty">Faculty</a>
    <a href="#contact">Contact</a>

</div>

<div class="content">

    <!-- HOME PAGE -->

    <div id="home" class="page">

        <h1>College Dashboard</h1>

        <p>Providing quality education since 2003.</p>

        <div class="row">

            <div class="col-md-4">

                <div class="card bg-primary text-white">

                    <h3>Total Students</h3>
                    <h2>1200</h2>

                </div>

            </div>

            <div class="col-md-4">

                <div class="card bg-success text-white">

                    <h3>Total Courses</h3>
                    <h2>10</h2>

                </div>

            </div>

            <div class="col-md-4">

                <div class="card bg-danger text-white">

                    <h3>Total Faculty</h3>
                    <h2>50</h2>

                </div>

            </div>

        </div>

    </div>

    <!-- COURSES PAGE -->

    <div id="courses" class="page">

        <h1>Courses</h1>

        <ul class="list-group">

            <li class="list-group-item">Information Technology</li>
            <li class="list-group-item">Computer Engineering</li>
            <li class="list-group-item">ENTC</li>

        </ul>

    </div>

    <!-- FACULTY PAGE -->

    <div id="faculty" class="page">

        <h1>Faculty</h1>

        <table class="table table-bordered">

            <tr>
                <th>Name</th>
                <th>Department</th>
            </tr>

            <tr>
                <td>Dr. Jyoti Surve</td>
                <td>IT</td>
            </tr>

            <tr>
                <td>Prof. Anuja Chavan</td>
                <td>IT</td>
            </tr>

            <tr>
                <td>Prof. Swati Shinde</td>
                <td>IT</td>
            </tr>

        </table>

    </div>

    <!-- CONTACT PAGE -->

    <div id="contact" class="page">

        <h1>Contact Us</h1>

        <form>

            <input type="text" class="form-control mb-3" placeholder="Enter Name">

            <input type="email" class="form-control mb-3" placeholder="Enter Email">

            <textarea class="form-control mb-3" placeholder="Enter Message"></textarea>

            <button class="btn btn-primary">
                Submit
            </button>

        </form>

    </div>

</div>

</body>
</html>
