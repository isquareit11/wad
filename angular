title = 'registration';

  displayname = '';
  displayaddress = '';
  displayemail = '';
  displaycontact = '';
  displaypassword = '';

  getvalues(name: string, address: string, email: string, contact: string, password: string) {
    this.displayname = name;
    this.displayaddress = address;
    this.displayemail = email;
    this.displaycontact = contact;
    this.displaypassword = password;
}

